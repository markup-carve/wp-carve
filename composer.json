{
    "name": "markup-carve/wp-carve",
    "description": "WordPress plugin for the Carve markup language: render Carve in posts, pages and comments, with a live in-browser preview, multi-format paste, frontmatter-to-meta, render caching and a REST API.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Scherer",
            "homepage": "https://www.dereuromark.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "markup-carve/carve-php": "dev-main#4fcf2b77d556220d8529740bc35705a060e8292b as 0.1.4",
        "markup-carve/carve-php-media-embed": "^0.1.1",
        "torchlight/engine": "^1.0",
        "markup-carve/carve-grammars": "dev-main#1a4b0ff2fa493ee5e382d14a95c89839c25b0e98"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "php-collective/code-sniffer": "^0.6.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4 || ^12.3 || ^13.0",
        "rector/rector": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-cli/wp-cli": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "WpCarve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpCarve\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.10"
        }
    },
    "scripts": {
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "stan": "phpstan analyze",
        "test": "phpunit",
        "post-install-cmd": [
            "php scripts/patch-phiki-offsets.php"
        ],
        "post-update-cmd": [
            "php scripts/patch-phiki-offsets.php"
        ]
    }
}
