{
    "name": "markup-carve/wp-carve",
    "description": "WordPress plugin for the Carve markup language: render Carve in posts, pages and comments, with a live in-browser preview, multi-format paste, frontmatter-to-meta, render caching and a REST API.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Scherer",
            "homepage": "https://www.dereuromark.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "markup-carve/carve-grammars": "dev-main#53c9e26e941c9b72654f141e54a38430da5dea23",
        "markup-carve/carve-php": "dev-main#83531ad57ee13280615e81f1a8f26309cb3525b8 as 0.1.17",
        "markup-carve/carve-php-media-embed": "dev-main#522ec93eec6669bfed57905b136ad209f4ec4c63",
        "torchlight/engine": "^1.0"
    },
    "prefer-stable": true,
    "require-dev": {
        "johnpbloch/wordpress-core": "6.8.11",
        "php-collective/code-sniffer": "^0.6.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4 || ^12.3 || ^13.0",
        "rector/rector": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-cli/wp-cli": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "WpCarve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpCarve\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.10"
        }
    },
    "scripts": {
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "stan": "phpstan analyze",
        "test": "phpunit",
        "profiles-table": "php scripts/generate-profile-table.php"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/markup-carve/carve-php"
        },
        {
            "type": "vcs",
            "url": "https://github.com/markup-carve/carve-php-media-embed"
        },
        {
            "type": "vcs",
            "url": "https://github.com/markup-carve/carve-grammars"
        }
    ]
}
